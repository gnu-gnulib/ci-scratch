#: src/test.c:661
msgid ""
"Usage: test EXPRESSION\n"
"  or:  test\n"
"  or:  [ EXPRESSION ]\n"
"  or:  [ ]\n"
"  or:  [ OPTION\n"
msgstr ""
"Uporaba: test IZRAZ\n"
"   ili:  test\n"
"   ili:  [ IZRAZ ]\n"
"   ili:  [ ]\n"
"   ili:  [ OPCIJA\n"

#: src/test.c:668
msgid ""
"Exit with the status determined by EXPRESSION.\n"
"\n"
msgstr ""
"Završava s izlaznim statusom određenim IZRAZOM.\n"
"\n"

#: src/test.c:674
msgid ""
"\n"
"An omitted EXPRESSION defaults to false.  Otherwise,\n"
"EXPRESSION is true or false and sets exit status.  It is one of:\n"
msgstr ""
"\n"
"Izostavljeni IZRAZ zadano je lažan. Inače, IZRAZ je\n"
"istinit ili lažan i postavlja izlazni status. Jedan je od sljedećih:\n"

#: src/test.c:679
msgid ""
"\n"
"  ( EXPRESSION )               EXPRESSION is true\n"
"  ! EXPRESSION                 EXPRESSION is false\n"
"  EXPRESSION1 -a EXPRESSION2   both EXPRESSION1 and EXPRESSION2 are true\n"
"  EXPRESSION1 -o EXPRESSION2   either EXPRESSION1 or EXPRESSION2 is true\n"
msgstr ""
"\n"
"  ( IZRAZ )                    IZRAZ je istinit\n"
"  ! IZRAZ                      IZRAZ je lažan\n"
"  IZRAZ1 -a IZRAZ2             oba IZRAZA su istinita\n"
"  IZRAZ1 -o IZRAZ2             barem jedan IZRAZ je istinit\n"

#: src/test.c:689
msgid "  -n STRING            the length of STRING is nonzero\n"
msgstr "  -n STRING            duljina STRINGA nije nula\n"

#: src/test.c:692
msgid "  STRING               equivalent to -n STRING\n"
msgstr "  STRING               istovrijedno s '-n STRING'\n"

#: src/test.c:695
msgid "  -z STRING            the length of STRING is zero\n"
msgstr "  -z STRING            duljina STRINGA je nula\n"

#: src/test.c:698
msgid ""
"  STRING1 = STRING2    the strings are equal\n"
"  STRING1 != STRING2   the strings are not equal\n"
"  STRING1 > STRING2    STRING1 is greater than STRING2 in the current "
"locale\n"
"  STRING1 < STRING2    STRING1 is less than STRING2 in the current locale\n"
msgstr ""
"  STRING1 = STRING2    stringovi su jednaki\n"
"  STRING1 != STRING2   stringovi nisu jednaki\n"
"  STRING1 > STRING2    STRING1 je veći od STRING2 u trenutačnoj "
"lokalizaciji\n"
"  STRING1 < STRING2    STRING1 je manji od STRING2 u trenutačnoj "
"lokalizaciji\n"

#: src/test.c:707
msgid "  INTEGER1 -eq INTEGER2   INTEGER1 is equal to INTEGER2\n"
msgstr "  BROJ1 -eq BROJ2         BROJ1 je jednak BROJU2\n"

#: src/test.c:710
msgid ""
"  INTEGER1 -ge INTEGER2   INTEGER1 is greater than or equal to INTEGER2\n"
msgstr "  BROJ1 -ge BROJ2         BROJ1 je veći ili jednak BROJU2\n"

#: src/test.c:713
msgid "  INTEGER1 -gt INTEGER2   INTEGER1 is greater than INTEGER2\n"
msgstr "  BROJ1 -gt BROJ2         BROJ1 je veći od BROJA2\n"

#: src/test.c:716
msgid "  INTEGER1 -le INTEGER2   INTEGER1 is less than or equal to INTEGER2\n"
msgstr "  BROJ1 -le BROJ2         BROJ1 je manji ili jednak BROJU2\n"

#: src/test.c:719
msgid "  INTEGER1 -lt INTEGER2   INTEGER1 is less than INTEGER2\n"
msgstr "  BROJ1 -lt BROJ2         BROJ1 je manji od BROJA2\n"

#: src/test.c:722
msgid "  INTEGER1 -ne INTEGER2   INTEGER1 is not equal to INTEGER2\n"
msgstr "  BROJ1 -ne BROJ2         BROJ1 nije jednak BROJU2\n"

#: src/test.c:728
msgid ""
"  FILE1 -ef FILE2   FILE1 and FILE2 have the same device and inode numbers\n"
msgstr "  DAT1 -ef DAT2     DAT1 i DAT2 imaju isti broj uređaja i inode\n"

#: src/test.c:731
msgid "  FILE1 -nt FILE2   FILE1 is newer (modification date) than FILE2\n"
msgstr "  DAT1 -nt DAT2     DAT1 je novija od DAT2 (datum izmjene)\n"

#: src/test.c:734
msgid "  FILE1 -ot FILE2   FILE1 is older than FILE2\n"
msgstr "  DAT1 -ot DAT2     DAT1 je starija od DAT2\n"

#: src/test.c:740
msgid "  -b FILE     FILE exists and is block special\n"
msgstr "  -b DATOTEKA DATOTEKA postoji i blokovna je posebna datoteka\n"

#: src/test.c:743
msgid "  -c FILE     FILE exists and is character special\n"
msgstr "  -c DATOTEKA DATOTEKA postoji i znakovna je posebna datoteka\n"

#: src/test.c:746
msgid "  -d FILE     FILE exists and is a directory\n"
msgstr "  -d DATOTEKA DATOTEKA postoji i direktorij je\n"

#: src/test.c:749
msgid "  -e FILE     FILE exists\n"
msgstr "  -e DATOTEKA DATOTEKA postoji\n"

#: src/test.c:752
msgid "  -f FILE     FILE exists and is a regular file\n"
msgstr "  -f DATOTEKA DATOTEKA postoji i obična je datoteka\n"

#: src/test.c:755
#, fuzzy
msgid "  -g FILE     FILE exists and its set-group-ID bit is set\n"
msgstr "  -u DATOTEKA DATOTEKA postoji i postavljen je bit 'set-user-ID'\n"

#: src/test.c:758
msgid "  -G FILE     FILE exists and is owned by the effective group ID\n"
msgstr "  -G DATOTEKA DATOTEKA postoji i u vlasništvu je efektivne grupe\n"

#: src/test.c:761
msgid "  -h FILE     FILE exists and is a symbolic link (same as -L)\n"
msgstr ""
"  -h DATOTEKA DATOTEKA postoji i simbolička je poveznica (isto što i '-L')\n"

#: src/test.c:764
msgid "  -k FILE     FILE exists and has its sticky bit set\n"
msgstr ""
"  -k DATOTEKA DATOTEKA postoji i postavljen je ljepljivi bit (sticky bit)\n"

#: src/test.c:767
msgid "  -L FILE     FILE exists and is a symbolic link (same as -h)\n"
msgstr ""
"  -L DATOTEKA DATOTEKA postoji i simbolička je poveznica (isto što i '-h')\n"

#: src/test.c:770
msgid ""
"  -N FILE     FILE exists and has been modified since it was last read\n"
msgstr ""
"  -N DATOTEKA DATOTEKA postoji i izmijenjena je od posljednjeg čitanja\n"

#: src/test.c:773
msgid "  -O FILE     FILE exists and is owned by the effective user ID\n"
msgstr ""
"  -O DATOTEKA DATOTEKA postoji i u vlasništvu je efektivnog korisnika\n"

#: src/test.c:776
msgid "  -p FILE     FILE exists and is a named pipe\n"
msgstr "  -p DATOTEKA DATOTEKA postoji i imenovana je cijev (FIFO)\n"

#: src/test.c:779
msgid "  -r FILE     FILE exists and the user has read access\n"
msgstr "  -r DATOTEKA DATOTEKA postoji i dopušteno je čitanje\n"

#: src/test.c:782
msgid "  -s FILE     FILE exists and has a size greater than zero\n"
msgstr "  -s DATOTEKA DATOTEKA postoji i njezina je veličina veća od nule\n"

#: src/test.c:785
msgid "  -S FILE     FILE exists and is a socket\n"
msgstr "  -S DATOTEKA DATOTEKA postoji i utičnica je (socket)\n"

#: src/test.c:788
msgid "  -t FD       file descriptor FD is opened on a terminal\n"
msgstr "  -t FD       deskriptor datoteke FD otvoren je na terminalu\n"

#: src/test.c:791
msgid "  -u FILE     FILE exists and its set-user-ID bit is set\n"
msgstr "  -u DATOTEKA DATOTEKA postoji i postavljen je bit 'set-user-ID'\n"

#: src/test.c:794
msgid "  -w FILE     FILE exists and the user has write access\n"
msgstr "  -w DATOTEKA DATOTEKA postoji i dopušteno je pisanje\n"

#: src/test.c:797
msgid "  -x FILE     FILE exists and the user has execute (or search) access\n"
msgstr ""
"  -x DATOTEKA DATOTEKA postoji i dopušteno je izvršavanje (ili "
"pretraživanje)\n"

#: src/test.c:800
msgid ""
"\n"
"Except for -h and -L, all FILE-related tests dereference symbolic links.\n"
"Beware that parentheses need to be escaped (e.g., by backslashes) for "
"shells.\n"
"INTEGER may also be -l STRING, which evaluates to the length of STRING.\n"
msgstr ""
"\n"
"Osim '-h' i '-L', svi testovi povezani s DATOTEKOM slijede simboličke\n"
"poveznice. Pazite da zagrade treba maskirati za ljuske (npr. obrnutom\n"
"kosom crtom). CIJELI_BROJ može biti i '-l STRING', što se računa kao\n"
"duljina STRINGA.\n"

#: src/test.c:806
msgid ""
"\n"
"Binary -a and -o are ambiguous.  Use 'test EXPR1 && test EXPR2'\n"
"or 'test EXPR1 || test EXPR2' instead.\n"
msgstr ""
"\n"
"Binarni '-a' i '-o' dvosmisleni su. Umjesto njih koristite\n"
"'test IZRAZ1 && test IZRAZ2' ili 'test IZRAZ1 || test IZRAZ2'.\n"

#: src/test.c:811
msgid ""
"\n"
"'[' honors --help and --version, but 'test' treats them as STRINGs.\n"
msgstr ""
"\n"
"'[' poštuje '--help' i '--version', dok ih 'test' smatra STRINGOVIMA.\n"

#: src/test.c:815
msgid "test and/or ["
msgstr "test i/ili ["

