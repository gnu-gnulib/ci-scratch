"  -q     izostavlja puno ime korisnika, udaljeno računalo i vrijeme\n"
"         mirovanja u kratkom formatu\n"

#: src/pinky.c:513
msgid ""
"      --lookup\n"
"         attempt to canonicalize hostnames via DNS\n"
msgstr ""
"      --lookup\n"
"         pokušava svesti imena računala na kanonski oblik putem DNS-a\n"

#: src/pinky.c:519
#, c-format
msgid ""
"\n"
"A lightweight 'finger' program;  print user information.\n"
"The utmp file will be %s.\n"
msgstr ""
"\n"
"Jednostavnija inačica programa 'finger'; ispisuje podatke o korisnicima.\n"
"Datoteka 'utmp' bit će %s.\n"

#: src/pinky.c:606
#, c-format
msgid "no username specified; at least one must be specified when using -l"
msgstr ""
"korisničko ime nije navedeno; najmanje jedno mora biti navedeno s opcijom '-"
"l'"

