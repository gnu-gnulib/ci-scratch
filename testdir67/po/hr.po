msgstr "nepravilno uparena konstrukcija [:upper:] i/ili [:lower:]"

#: src/tr.c:1310
#, c-format
msgid "too many characters in set"
msgstr "previše znakova u skupu"

#: src/tr.c:1393
#, c-format
msgid ""
"when translating with string1 longer than string2,\n"
"the latter string must not end with a character class"
msgstr ""
"pri pretvaranju sa stringom1 duljim od stringa2, potonji string ne smije\n"
