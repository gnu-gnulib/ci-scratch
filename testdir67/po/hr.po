msgstr "Dmitry V. Levin"

#: src/readlink.c:65 src/realpath.c:72 src/shred.c:169 src/stat.c:1760
#: src/touch.c:216
#, c-format
msgid "Usage: %s [OPTION]... FILE...\n"
msgstr "Uporaba: %s [OPCIJA]... DATOTEKA...\n"

#: src/readlink.c:66
msgid ""
"Print value of a symbolic link or canonical file name\n"
"\n"
msgstr ""
"Ispisuje vrijednost simboličke poveznice ili kanonski naziv datoteke.\n"
"\n"

#: src/readlink.c:68
msgid ""
"  -f, --canonicalize\n"
"         canonicalize by following every symlink\n"
"         in every component of the given name recursively;\n"
"         all but the last component must exist\n"
msgstr ""
"  -f, --canonicalize\n"
"         svodi na kanonski oblik rekurzivno slijedeći svaku simboličku\n"
"         poveznicu u svakoj komponenti zadanog naziva; sve komponente\n"
"         osim posljednje moraju postojati\n"

#: src/readlink.c:74
msgid ""
"  -e, --canonicalize-existing\n"
"         canonicalize by following every symlink\n"
"         in every component of the given name recursively;\n"
"         all components must exist\n"
msgstr ""
"  -e, --canonicalize-existing\n"
"         svodi na kanonski oblik rekurzivno slijedeći svaku simboličku\n"
"         poveznicu u svakoj komponenti zadanog naziva; sve komponente\n"
"         moraju postojati\n"

#: src/readlink.c:80
msgid ""
"  -m, --canonicalize-missing\n"
"         canonicalize by following every symlink\n"
"         in every component of the given name recursively,\n"
"         without requirements on components existence\n"
msgstr ""
"  -m, --canonicalize-missing\n"
"         svodi na kanonski oblik rekurzivno slijedeći svaku simboličku\n"
"         poveznicu u svakoj komponenti naziva, bez uvjeta o\n"
"         postojanju komponenta\n"

#: src/readlink.c:86
msgid ""
"  -n, --no-newline\n"
"         do not output the trailing delimiter\n"
msgstr ""
"  -n, --no-newline\n"
"         ne ispisuje završni graničnik\n"

#: src/readlink.c:90
msgid "  -q, --quiet\n"
msgstr "  -q, --quiet\n"

#: src/readlink.c:93
msgid ""
"  -s, --silent\n"
"         suppress most error messages\n"
"         (on by default if POSIXLY_CORRECT is not set)\n"
msgstr ""
"  -s, --silent\n"
"         izostavlja većinu poruka o greškama (zadano ako\n"
"         nije postavljena varijabla POSIXLY_CORRECT)\n"

#: src/readlink.c:98
msgid ""
"  -v, --verbose\n"
"         report error messages\n"
"         (on by default if POSIXLY_CORRECT is set)\n"
msgstr ""
"  -v, --verbose\n"
"         ispisuje poruke o greškama (zadano ako je\n"
"         postavljena varijabla POSIXLY_CORRECT)\n"

#: src/readlink.c:173
#, c-format
msgid "ignoring --no-newline with multiple arguments"
msgstr "zanemaruje se opcija '--no-newline' s više argumenata"

#: src/realpath.c:73
msgid "Print the resolved absolute file name.\n"
msgstr "Ispisuje razriješeni apsolutni naziv datoteke.\n"

#: src/realpath.c:76
msgid ""
"  -E, --canonicalize           all but the last component must exist "
"(default)\n"
msgstr ""
"  -E, --canonicalize           sve komponente osim posljednje moraju\n"
"                               postojati (zadano)\n"

#: src/realpath.c:80
msgid "  -e, --canonicalize-existing  all components of the path must exist\n"
msgstr "  -e, --canonicalize-existing  sve komponente staze moraju postojati\n"

#: src/realpath.c:83
msgid ""
"  -m, --canonicalize-missing   no path components need exist or be a "
"directory\n"
msgstr ""
"  -m, --canonicalize-missing   komponente staze ne moraju postojati niti\n"
"                               biti direktoriji\n"

#: src/realpath.c:87
msgid ""
"  -L, --logical                resolve '..' components before symlinks\n"
msgstr ""
"  -L, --logical                razrješava komponente '..' prije\n"
"                               simboličkih poveznica\n"

#: src/realpath.c:90
msgid ""
"  -P, --physical               resolve symlinks as encountered (default)\n"
msgstr ""
"  -P, --physical               razrješava simboličke poveznice pri\n"
"                               nailasku (zadano)\n"

#: src/realpath.c:93
msgid "  -q, --quiet                  suppress most error messages\n"
msgstr "  -q, --quiet                  izostavlja većinu poruka o greškama\n"

#: src/realpath.c:96
msgid ""
"      --relative-to=DIR        print the resolved path relative to DIR\n"
msgstr ""
"      --relative-to=DIR        ispisuje razriješenu stazu relativno\n"
"                               prema direktoriju DIR\n"

#: src/realpath.c:99
msgid ""
"      --relative-base=DIR      print absolute paths unless paths below DIR\n"
msgstr ""
"      --relative-base=DIR      ispisuje apsolutne staze osim ako su staze\n"
"                               ispod direktorija DIR\n"

#: src/realpath.c:102
msgid "  -s, --strip, --no-symlinks   don't expand symlinks\n"
msgstr "  -s, --strip, --no-symlinks   ne razrješava simboličke poveznice\n"

#: src/realpath.c:105
msgid ""
"  -z, --zero                   end each output line with NUL, not newline\n"
msgstr ""
"  -z, --zero                   završava svaki izlazni redak s NUL znakom,\n"
"                               a ne sa znakom za novi redak\n"

#: src/relpath.c:130
msgid "generating relative path"
msgstr "stvara se relativna staze"

#: src/remove.c:278
#, c-format
