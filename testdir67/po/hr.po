msgstr "konstrukcija [c*] smije se pojaviti u stringu2 samo pri pretvaranju"

#: src/tr.c:1751
msgid "Two strings must be given when both deleting and squeezing repeats."
msgstr "Pri brisanju i sažimanju ponavljanja moraju biti zadana dva stringa."

#: src/tr.c:1753
