#: src/sleep.c:42
#, c-format
msgid ""
"Usage: %s NUMBER[SUFFIX]...\n"
"  or:  %s OPTION\n"
"Pause for NUMBER seconds, where NUMBER is an integer or floating-point.\n"
"SUFFIX may be 's','m','h', or 'd', for seconds, minutes, hours, days.\n"
"With multiple arguments, pause for the sum of their values.\n"
"\n"
msgstr ""
"Uporaba: %s BROJ[SUFIKS]...\n"
"   ili:  %s OPCIJA\n"
"Miruje u trajanju od BROJ sekundi; BROJ može biti cijeli ili broj s\n"
"pomičnim zarezom. SUFIKS može biti 's', 'm', 'h' ili 'd' (sekunde,\n"
"minute, sati ili dani). S više argumenata miruje u trajanju njihova zbroja.\n"
"\n"

#: src/sleep.c:131 src/timeout.c:386
#, c-format
msgid "invalid time interval %s"
msgstr "neispravan vremenski interval %s"

#: src/sleep.c:142 src/tail.c:1345
#, c-format
msgid "cannot read realtime clock"
msgstr "nije moguće čitati sat stvarnog vremena"

#: src/sort.c:436
msgid "Write sorted concatenation of all FILE(s) to standard output.\n"
msgstr "Ispisuje razvrstani spoj svih DATOTEKA na standardni izlaz.\n"

#: src/sort.c:443
msgid ""
"Ordering options:\n"
"\n"
msgstr ""
"Opcije razvrstavanja:\n"
"\n"

#: src/sort.c:447
msgid ""
"  -b, --ignore-leading-blanks\n"
"         ignore leading blanks when finding sort keys in each line\n"
msgstr ""
"  -b, --ignore-leading-blanks\n"
"         zanemaruje vodeće bjeline u retku pri traženju ključeva "
"razvrstavanja\n"

#: src/sort.c:451
msgid ""
"  -d, --dictionary-order\n"
"         consider only blanks and alphanumeric characters\n"
msgstr ""
"  -d, --dictionary-order\n"
"         uzima u obzir samo bjeline i alfanumeričke znakove\n"

#: src/sort.c:455
msgid ""
"  -f, --ignore-case\n"
"         fold lower case to upper case characters\n"
msgstr ""
"  -f, --ignore-case\n"
"         zanemaruje razliku malih i velikih slova\n"

#: src/sort.c:459
msgid ""
"  -g, --general-numeric-sort\n"
"         compare according to general numerical value\n"
msgstr ""
"  -g, --general-numeric-sort\n"
"         uspoređuje prema općoj brojčanoj vrijednosti\n"

#: src/sort.c:463
msgid ""
"  -i, --ignore-nonprinting\n"
"         consider only printable characters\n"
msgstr ""
"  -i, --ignore-nonprinting\n"
"         uzima u obzir samo ispisive znakove\n"

#: src/sort.c:467
msgid ""
"  -M, --month-sort\n"
"         compare (unknown) < 'JAN' < ... < 'DEC'\n"
msgstr ""
"  -M, --month-sort\n"
"         uspoređuje nazive mjeseci: (nepoznato) < 'JAN' < ... < 'DEC'\n"

#: src/sort.c:471
msgid ""
"  -h, --human-numeric-sort\n"
"         compare human readable numbers (e.g., 2K 1G)\n"
msgstr ""
"  -h, --human-numeric-sort\n"
"         uspoređuje čitljive brojeve (npr. 2K, 1G)\n"

#: src/sort.c:475
msgid ""
"  -n, --numeric-sort\n"
"         compare according to string numerical value;\n"
"         see full documentation for supported strings\n"
msgstr ""
"  -n, --numeric-sort\n"
"         uspoređuje prema brojčanoj vrijednosti stringa; vidi\n"
"         potpunu dokumentaciju za podržane stringove\n"

#: src/sort.c:480
msgid ""
"  -R, --random-sort\n"
"         shuffle, but group identical keys.  See also shuf(1)\n"
msgstr ""
"  -R, --random-sort\n"
"         miješa, ali grupira identične ključeve; v. shuf(1)\n"

#: src/sort.c:488
msgid ""
"  -r, --reverse\n"
"         reverse the result of comparisons\n"
msgstr ""
"  -r, --reverse\n"
"         obrne rezultat usporedbi\n"

#: src/sort.c:492
msgid ""
"      --sort=WORD\n"
"         sort according to WORD:\n"
"           general-numeric -g, human-numeric -h, month -M,\n"
"           numeric -n, random -R, version -V\n"
msgstr ""
"      --sort=RIJEČ\n"
"         razvrstavanje prema RIJEČI; RIJEČ može biti:\n"
"         'general-numeric' (-g), 'human-numeric' (-h), 'month' (-M),\n"
"         'numeric' (-n), 'random' (-R), 'version' (-V)\n"

#: src/sort.c:498
msgid ""
"  -V, --version-sort\n"
"         natural sort of (version) numbers within text\n"
msgstr ""
"  -V, --version-sort\n"
"         prirodno razvrstavanje brojeva inačica unutar teksta\n"

#: src/sort.c:502
msgid ""
"\n"
"Other options:\n"
"\n"
msgstr ""
"\n"
"Ostale opcije:\n"
"\n"

#: src/sort.c:507
msgid ""
"      --batch-size=NMERGE\n"
"         merge at most NMERGE inputs at once; for more use temp files\n"
msgstr ""
"      --batch-size=NMERGE\n"
"         objedinjuje najviše NMERGE ulaza odjednom; za više\n"
"         upotrijebite privremene datoteke\n"

#: src/sort.c:511
msgid ""
"  -c, --check, --check=diagnose-first\n"
"         check for sorted input; do not sort\n"
msgstr ""
"  -c, --check, --check=diagnose-first\n"
"         provjerava je li ulaz razvrstan; ne razvrstava\n"

#: src/sort.c:515
msgid ""
"  -C, --check=quiet, --check=silent\n"
"         like -c, but do not report first bad line\n"
msgstr ""
"  -C, --check=quiet, --check=silent\n"
"         kao '-c', ali ne prijavljuje prvi neispravan redak\n"

#: src/sort.c:519
msgid ""
"      --compress-program=PROG\n"
"         compress temporaries with PROG; decompress them with PROG -d\n"
msgstr ""
"      --compress-program=PROG\n"
"         sažima privremene datoteke programom PROG; raspakirava\n"
"         ih programom PROG -d\n"

#: src/sort.c:523
msgid ""
"      --debug\n"
"         annotate the part of the line used to sort,\n"
"         and warn about questionable usage to standard error\n"
msgstr ""
"      --debug\n"
"         označava dio retka koji se koristi za razvrstavanje\n"
"         i upozorava na upitnu uporabu na standardnu grešku\n"

#: src/sort.c:528
msgid ""
"      --files0-from=F\n"
"         read input from the files specified by NUL-terminated names in file "
"F;\n"
"         If F is -, read names from standard input\n"
msgstr ""
"      --files0-from=F\n"
"         čita ulaz iz datoteka čiji su nazivi, završeni NUL znakom,\n"
"         navedeni u datoteci F; ako je F '-', čita nazive sa standardnog "
"ulaza\n"

#: src/sort.c:534
msgid ""
"  -k, --key=KEYDEF\n"
"         sort via a key; KEYDEF gives location and type\n"
msgstr ""
"  -k, --key=KEYDEF\n"
"         razvrstava prema ključu; KEYDEF određuje položaj i vrstu\n"

#: src/sort.c:538
msgid ""
"  -m, --merge\n"
"         merge already sorted files; do not sort\n"
msgstr ""
"  -m, --merge\n"
"         objedinjuje već razvrstane datoteke; ne razvrstava\n"

#: src/sort.c:542
msgid ""
"  -o, --output=FILE\n"
"         write result to FILE instead of standard output\n"
msgstr ""
"  -o, --output=DATOTEKA\n"
"         piše rezultat u DATOTEKU umjesto na standardni izlaz\n"

#: src/sort.c:546
msgid ""
"  -s, --stable\n"
"         stabilize sort by disabling last-resort comparison\n"
msgstr ""
"  -s, --stable\n"
"         stabilizira razvrstavanje isključivanjem konačne usporedbe\n"

#: src/sort.c:550
msgid ""
"  -S, --buffer-size=SIZE\n"
"         use SIZE for main memory buffer\n"
msgstr ""
"  -S, --buffer-size=VELIČINA\n"
"         upotrebljava VELIČINU za međuspremnik u radnoj memoriji\n"

#: src/sort.c:554
msgid ""
"  -t, --field-separator=SEP\n"
"         use SEP instead of non-blank to blank transition\n"
msgstr ""
"  -t, --field-separator=RAZDJELNIK\n"
"         upotrebljava RAZDJELNIK umjesto prijelaza s nebjeline na bjelinu\n"

#: src/sort.c:558
#, c-format
msgid ""
"  -T, --temporary-directory=DIR\n"
"         use DIR for temporaries, not $TMPDIR or %s;\n"
"         multiple options specify multiple directories\n"
msgstr ""
"  -T, --temporary-directory=DIR\n"
"         upotrebljava DIR za privremene datoteke, a ne $TMPDIR ili %s;\n"
"         više opcija određuje više direktorija\n"

#: src/sort.c:563
msgid ""
"      --parallel=N\n"
"         change the number of sorts run concurrently to N\n"
msgstr ""
"      --parallel=N\n"
"         mijenja broj istodobnih razvrstavanja na N\n"

#: src/sort.c:567
msgid ""
"  -u, --unique\n"
"         output only the first of lines with equal keys;\n"
"         with -c, check for strict ordering\n"
msgstr ""
"  -u, --unique\n"
"         ispisuje samo prvi od redaka s jednakim ključevima;\n"
"         s '-c' provjerava strogi poredak\n"

#: src/sort.c:578
msgid ""
"\n"
"KEYDEF is F[.C][OPTS][,F[.C][OPTS]] for start and stop position, where F is "
"a\n"
"field number and C a character position in the field; both are origin 1, "
"and\n"
"the stop position defaults to the line's end.  If neither -t nor -b is in\n"
"effect, characters in a field are counted from the beginning of the "
"preceding\n"
"whitespace.  OPTS is one or more single-letter ordering options "
"[bdfgiMhnRrV],\n"
"which override global ordering options for that key.  If no key is given, "
"use\n"
"the entire line as the key.  Use --debug to diagnose incorrect key usage.\n"
"\n"
"SIZE may be followed by the following multiplicative suffixes:\n"
msgstr ""
"\n"
"KEYDEF je: P[.Z][OPCIJE][,P[.Z][OPCIJE]] za početni i završni položaj, pri "
"čemu\n"
"je P broj polja, a Z položaj znaka u polju; oba se broje od 1, zadano je "
"završni\n"
"položaj kraj retka. Ako ni '-t' ni '-b' nisu aktivni, znakovi u polju broje "
"se\n"
"od početka prethodne bjeline. OPCIJE su jedna ili više jednoslovnih opcija\n"
"razvrstavanja [bdfgiMhnRrV] koje nadjačavaju opće opcije razvrstavanja za "
"taj\n"
"ključ. Ako ključ nije naveden, cijeli se redak upotrebljava kao ključ.\n"
"Upotrijebite '--debug' za dijagnosticiranje neispravne uporabe ključa.\n"
"\n"
"Iza VELIČINE mogu slijediti ovi sufiksi u ulozi množitelja:\n"

#: src/sort.c:591
msgid ""
"% 1% of memory, b 1, K 1024 (default), and so on for M, G, T, P, E, Z, Y, R, "
"Q.\n"
"\n"
"*** WARNING ***\n"
"The locale specified by the environment affects sort order.\n"
"Set LC_ALL=C to get the traditional sort order that uses\n"
"native byte values.\n"
msgstr ""
"% 1% memorije, b 1, K 1024 (zadano), itd. za M, G, T, P, E, Z, Y, R, Q.\n"
"\n"
"*** UPOZORENJE ***\n"
"Lokalizacija, određena s okruženjem, utječe na redoslijed sortiranja.\n"
"Postavite LC_ALL=C za tradicionalni poredak razvrstavanja koji upotrebljava\n"
"izvorne vrijednosti bajtova.\n"

