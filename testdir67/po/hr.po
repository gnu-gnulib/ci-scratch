#: src/cksum.c:668
msgid ""
"\n"
"DIGEST determines the digest algorithm and default output format:\n"
"  sysv      (equivalent to sum -s)\n"
"  bsd       (equivalent to sum -r)\n"
"  crc       (equivalent to cksum)\n"
"  crc32b    (only available through cksum)\n"
"  md5       (equivalent to md5sum)\n"
"  sha1      (equivalent to sha1sum)\n"
"  sha2      (equivalent to sha{224,256,384,512}sum)\n"
"  sha3      (only available through cksum)\n"
"  blake2b   (equivalent to b2sum)\n"
"  sm3       (only available through cksum)\n"
"\n"
msgstr ""
"\n"
"SAŽETAK određuje algoritam sažetka i zadani izlazni format:\n"
"  sysv      (istovrijedno 'sum -s)'\n"
"  bsd       (istovrijedno 'sum -r)'\n"
"  crc       (istovrijedno 'cksum)'\n"
"  crc32b    (dostupno samo putem 'cksum')\n"
"  md5       (istovrijedno 'md5sum')\n"
"  sha1      (istovrijedno 'sha1sum')\n"
"  sha2      (istovrijedno 'sha{224,256,384,512}sum')\n"
"  sha3      (dostupno samo putem 'cksum')\n"
"  blake2b   (istovrijedno 'b2sum')\n"
"  sm3       (dostupno samo putem 'cksum')\n"
"\n"

