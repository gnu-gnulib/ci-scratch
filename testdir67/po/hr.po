msgid ""
"Usage: %s [ignored command line arguments]\n"
"  or:  %s OPTION\n"
msgstr ""
"Uporaba: %s [argumenti naredbenog retka su zanemareni]\n"
"   ili:  %s OPCIJA\n"

#: src/true.c:38
msgid "Exit with a status code indicating success."
msgstr "Završava s izlaznim statusom koji označava uspjeh."

