#: src/stdbuf.c:83
#, c-format
msgid "Usage: %s OPTION... COMMAND\n"
msgstr "Uporaba: %s OPCIJA... NAREDBA\n"

#: src/stdbuf.c:84
msgid ""
"Run COMMAND, with modified buffering operations for its standard streams.\n"
msgstr ""
"Pokreće NAREDBU s prilagođenim međuspremanjem za njezine standardne tokove.\n"

#: src/stdbuf.c:90
msgid "  -i, --input=MODE   adjust standard input stream buffering\n"
msgstr ""
"  -i, --input=NAČIN   prilagođava međuspremanje standardnog ulaznog toka\n"

#: src/stdbuf.c:93
msgid "  -o, --output=MODE  adjust standard output stream buffering\n"
msgstr ""
"  -o, --output=NAČIN prilagođava međuspremanje standardnog izlaznog toka\n"

#: src/stdbuf.c:96
msgid "  -e, --error=MODE   adjust standard error stream buffering\n"
msgstr ""
"  -e, --error=NAČIN    prilagođava međuspremanje toka standardne greške\n"

#: src/stdbuf.c:101
msgid ""
"\n"
"If MODE is 'L' the corresponding stream will be line buffered.\n"
"This option is invalid with standard input.\n"
msgstr ""
"\n"
"Ako je NAČIN 'L', odgovarajući se tok međusprema po redcima.\n"
"Ova opcija nije ispravna za standardni ulaz.\n"

#: src/stdbuf.c:104
msgid ""
"\n"
"If MODE is '0' the corresponding stream will be unbuffered.\n"
msgstr ""
"\n"
"Ako je NAČIN '0', odgovarajući je tok bez međuspremanja.\n"

#: src/stdbuf.c:107
msgid ""
"\n"
"Otherwise MODE is a number which may be followed by one of the following:\n"
"KB 1000, K 1024, MB 1000*1000, M 1024*1024, and so on for G,T,P,E,Z,Y,R,Q.\n"
"Binary prefixes can be used, too: KiB=K, MiB=M, and so on.\n"
"In this case the corresponding stream will be fully buffered with the "
"buffer\n"
"size set to MODE bytes.\n"
msgstr ""
"\n"
"U suprotnom, NAČIN je broj iza kojeg može slijediti jedan od ovih sufiksa:\n"
"KB 1000, K 1024, MB 1000*1000, M 1024*1024 i tako dalje za G,T,P,E,Z,Y,R,Q.\n"
"Mogu se koristiti i binarni prefiksi: KiB=K, MiB=M itd.\n"
"U tom će slučaju odgovarajući tok biti potpuno međuspremljen s veličinom\n"
"međuspremnika postavljenom na NAČIN bajtova.\n"

#: src/stdbuf.c:114
msgid ""
"\n"
"NOTE: If COMMAND adjusts the buffering of its standard streams ('tee' does\n"
"for example) then that will override corresponding changes by 'stdbuf'.\n"
"Also some filters (like 'dd' and 'cat' etc.) don't use streams for I/O,\n"
"and are thus unaffected by 'stdbuf' settings.\n"
msgstr ""
"\n"
"NAPOMENA: Ako NAREDBA sama prilagođava međuspremanje svojih standardnih\n"
"tokova (primjerice 'tee'), to će nadjačati odgovarajuće promjene alata\n"
"'stdbuf'. Također, neki filtri (poput 'dd', 'cat' itd.) ne koriste tokove\n"
"za U/I, pa na njih postavke 'stdbuf' nemaju utjecaja.\n"

#: src/stdbuf.c:245
#, c-format
msgid "failed to find %s"
msgstr "nije uspjelo pronaći %s"

#: src/stdbuf.c:268 src/stdbuf.c:299
#, c-format
msgid "failed to update the environment with %s"
msgstr "nije uspjelo ažurirati okruženje s %s"

#: src/stdbuf.c:345
#, c-format
msgid "line buffering standard input is meaningless"
msgstr "međuspremanje standardnog ulaza po redcima nema smisla"

#: src/stdbuf.c:380
#, c-format
msgid "you must specify a buffering mode option"
msgstr "morate navesti opciju načina međuspremanja"

#: src/stty.c:545
#, c-format
msgid ""
"Usage: %s [-F DEVICE | --file=DEVICE] [SETTING]...\n"
"  or:  %s [-F DEVICE | --file=DEVICE] [-a|--all]\n"
"  or:  %s [-F DEVICE | --file=DEVICE] [-g|--save]\n"
msgstr ""
"Uporaba: %s [-F UREĐAJ | --file=UREĐAJ] [POSTAVKE]...\n"
"   ili:  %s [-F UREĐAJ | --file=UREĐAJ] [-a|--all]\n"
"   ili:  %s [-F UREĐAJ | --file=UREĐAJ] [-g|--save]\n"

#: src/stty.c:551
msgid "Print or change terminal characteristics.\n"
msgstr "Ispisuje ili mijenja svojstva terminala.\n"

#: src/stty.c:557
msgid ""
"  -a, --all          print all current settings in human-readable form\n"
msgstr ""
"  -a, --all          ispisuje sve trenutačne postavke u čitljivom obliku\n"

#: src/stty.c:560
msgid ""
"  -g, --save         print all current settings in a stty-readable form\n"
msgstr ""
"  -g, --save         ispisuje sve trenutačne postavke u 'stty' čitljivom "
"obliku\n"

#: src/stty.c:563
msgid "  -F, --file=DEVICE  open and use DEVICE instead of standard input\n"
msgstr ""
"  -F, --file=UREĐAJ  otvara i upotrebljava UREĐAJ umjesto standardnog ulaza\n"

#: src/stty.c:568
msgid ""
"\n"
"Optional - before SETTING indicates negation.  An * marks non-POSIX\n"
"settings.  The underlying system defines which settings are available.\n"
msgstr ""
"\n"
"Neobvezatni znak '-' ispred POSTAVKE označava negaciju. Znak '*' označava\n"
"postavke koje nisu dio standarda POSIX. Dostupne postavke ovise o sustavu.\n"

#: src/stty.c:573
msgid ""
"\n"
"Special characters:\n"
msgstr ""
"\n"
"Posebni znakovi:\n"

#: src/stty.c:577
msgid " * discard CHAR  CHAR will toggle discarding of output\n"
msgstr " * discard ZNAK  ZNAK uključuje ili isključuje odbacivanje izlaza\n"

#: src/stty.c:582
msgid ""
" * dsusp CHAR    CHAR will send a terminal stop signal once input flushed\n"
msgstr ""
" * dsusp ZNAK    ZNAK šalje signal zaustavljanja terminala nakon\n"
"                 pražnjenja ulaza\n"

#: src/stty.c:586
msgid ""
"   eof CHAR      CHAR will send an end of file (terminate the input)\n"
"   eol CHAR      CHAR will end the line\n"
msgstr ""
"   eof ZNAK      ZNAK šalje kraj datoteke (završava unos)\n"
"   eol ZNAK      ZNAK završava redak\n"

#: src/stty.c:591
msgid " * eol2 CHAR     alternate CHAR for ending the line\n"
msgstr " * eol2 ZNAK     alternativni ZNAK za završavanje retka\n"

#: src/stty.c:595
msgid ""
"   erase CHAR    CHAR will erase the last character typed\n"
"   intr CHAR     CHAR will send an interrupt signal\n"
"   kill CHAR     CHAR will erase the current line\n"
msgstr ""
"   erase ZNAK    ZNAK briše posljednji utipkani znak\n"
"   intr ZNAK     ZNAK šalje signal prekida\n"
"   kill ZNAK     ZNAK briše trenutačni redak\n"

#: src/stty.c:601
msgid " * lnext CHAR    CHAR will enter the next character quoted\n"
msgstr " * lnext ZNAK    ZNAK omogućuje doslovni unos sljedećeg znaka\n"

#: src/stty.c:606
msgid " * status CHAR   CHAR will send an info signal\n"
msgstr " * status ZNAK   ZNAK šalje informacijski signal\n"

#: src/stty.c:610
msgid "   quit CHAR     CHAR will send a quit signal\n"
msgstr "   quit ZNAK     ZNAK šalje signal izlaza\n"

#: src/stty.c:614
msgid " * rprnt CHAR    CHAR will redraw the current line\n"
msgstr " * rprnt ZNAK    ZNAK ponovno ispisuje trenutačni redak\n"

#: src/stty.c:618
msgid ""
"   start CHAR    CHAR will restart the output after stopping it\n"
"   stop CHAR     CHAR will stop the output\n"
"   susp CHAR     CHAR will send a terminal stop signal\n"
msgstr ""
"   start ZNAK    ZNAK ponovno pokreće izlaz nakon zaustavljanja\n"
"   stop ZNAK     ZNAK zaustavlja izlaz\n"
"   susp ZNAK     ZNAK šalje signal zaustavljanja terminala\n"

#: src/stty.c:624
msgid " * swtch CHAR    CHAR will switch to a different shell layer\n"
msgstr " * swtch ZNAK    ZNAK prebacuje na drugu razinu ljuske\n"

#: src/stty.c:629
msgid " * werase CHAR   CHAR will erase the last word typed\n"
msgstr " * werase ZNAK   ZNAK briše posljednju utipkanu riječ\n"

#: src/stty.c:633
msgid ""
"\n"
"Special settings:\n"
"   N             set the input and output speeds to N bauds\n"
msgstr ""
"\n"
"Posebne postavke:\n"
"   N             postavlja ulaznu i izlaznu brzinu na N bauda\n"

#: src/stty.c:639
msgid ""
"   cols N        tell the kernel that the terminal has N columns\n"
" * columns N     same as cols N\n"
msgstr ""
"   cols N        javlja jezgri da terminal ima N stupaca\n"
" * columns N     isto što i 'cols N'\n"

#: src/stty.c:644
#, c-format
msgid ""
" * [-]drain      wait for transmission before applying settings (%s by "
"default)\n"
msgstr ""
" * [-]drain      čeka završetak prijenosa prije primjene postavki\n"
"                   (zadano: %s)\n"

#: src/stty.c:646
msgid "on"
msgstr "uključeno"

#: src/stty.c:646
msgid "off"
msgstr "isključeno"

#: src/stty.c:647
msgid "   ispeed N      set the input speed to N\n"
msgstr "   ispeed N      postavlja ulaznu brzinu na N\n"

#: src/stty.c:651
msgid " * line N        use line discipline N\n"
msgstr " * line N        koristi disciplinu retka N\n"

#: src/stty.c:655
msgid ""
"   min N         with -icanon, set N characters minimum for a completed "
"read\n"
"   ospeed N      set the output speed to N\n"
msgstr ""
"   min N         s '-icanon': postavlja najmanje N znakova za dovršeno "
"čitanje\n"
"   ospeed N      postavlja izlaznu brzinu na N\n"

#: src/stty.c:660
msgid ""
"   rows N        tell the kernel that the terminal has N rows\n"
"   size          print the number of rows and columns according to the "
"kernel\n"
msgstr ""
"   rows N        javlja jezgri da terminal ima N redaka\n"
"   size          ispisuje broj redaka i stupaca prema podacima iz jezgre\n"

#: src/stty.c:665
msgid ""
"   speed         print the terminal speed\n"
"   time N        with -icanon, set read timeout of N tenths of a second\n"
msgstr ""
"   speed         ispisuje brzinu terminala\n"
"   time N        s '-icanon': postavlja vremensko ograničenje čitanja na N\n"
"                 desetinki sekunde\n"

#: src/stty.c:669
msgid ""
"\n"
"Control settings:\n"
"   [-]clocal     disable modem control signals\n"
"   [-]cread      allow input to be received\n"
msgstr ""
"\n"
"Kontrolne postavke:\n"
"   [-]clocal     onemogućuje upravljačke signale modema\n"
"   [-]cread      dopušta primanje ulaza\n"

#: src/stty.c:676
msgid " * [-]crtscts    enable RTS/CTS handshaking\n"
msgstr " * [-]crtscts    omogućuje RTS/CTS rukovanje\n"

#: src/stty.c:681
msgid " * [-]cdtrdsr    enable DTR/DSR handshaking\n"
msgstr " * [-]cdtrdsr    omogućuje DTR/DSR rukovanje\n"

#: src/stty.c:685
msgid "   csN           set character size to N bits, N in [5..8]\n"
msgstr "   csN           postavlja veličinu znaka na N bitova, N u [5..8]\n"

#: src/stty.c:688
msgid ""
"   [-]cstopb     use two stop bits per character (one with '-')\n"
"   [-]hup        send a hangup signal when the last process closes the tty\n"
"   [-]hupcl      same as [-]hup\n"
"   [-]parenb     generate parity bit in output and expect parity bit in "
"input\n"
"   [-]parodd     set odd parity (or even parity with '-')\n"
msgstr ""
"   [-]cstopb     upotrebljava dva zaustavna bita po znaku (jedan s '-')\n"
"   [-]hup        šalje signal prekida veze (HUP) kad posljednji proces\n"
"                 zatvori tty\n"
"   [-]hupcl      isto što i '[-]hup'\n"
"   [-]parenb     stvara bit pariteta na izlazu i očekuje ga na ulazu\n"
"   [-]parodd     postavlja neparan paritet (ili paran s '-')\n"

#: src/stty.c:696
msgid " * [-]cmspar     use \"stick\" (mark/space) parity\n"
msgstr " * [-]cmspar     upotrebljava \"stick\" paritet (mark/space)\n"

#: src/stty.c:700
msgid ""
"\n"
"Input settings:\n"
"   [-]brkint     breaks cause an interrupt signal\n"
"   [-]icrnl      translate carriage return to newline\n"
"   [-]ignbrk     ignore break characters\n"
"   [-]igncr      ignore carriage return\n"
"   [-]ignpar     ignore characters with parity errors\n"
msgstr ""
"\n"
"Postavke ulaza:\n"
"   [-]brkint     prekidi uzrokuju signal prekida\n"
"   [-]icrnl      pretvara povratak na početak (CR) u novi redak (LF)\n"
"   [-]ignbrk     zanemaruje znakove prekida\n"
"   [-]igncr      zanemaruje povratak na početak (CR)\n"
"   [-]ignpar     zanemaruje znakove s greškom pariteta\n"

#: src/stty.c:710
msgid ""
" * [-]imaxbel    beep and do not flush a full input buffer on a character\n"
msgstr ""
" * [-]imaxbel    oglašava se i ne prazni puni ulazni međuspremnik pri znaku\n"

#: src/stty.c:714
msgid ""
"   [-]inlcr      translate newline to carriage return\n"
"   [-]inpck      enable input parity checking\n"
"   [-]istrip     clear high (8th) bit of input characters\n"
msgstr ""
"   [-]inlcr      pretvara novi redak (LF) u povratak na početak (CR)\n"
"   [-]inpck      omogućuje provjeru pariteta na ulazu\n"
"   [-]istrip     briše najviši (8.) bit ulaznih znakova\n"

#: src/stty.c:720
msgid " * [-]iutf8      assume input characters are UTF-8 encoded\n"
msgstr ""
" * [-]iutf8      pretpostavlja da su ulazni znakovi kodirani kao UTF-8\n"

#: src/stty.c:725
msgid " * [-]iuclc      translate uppercase characters to lowercase\n"
msgstr " * [-]iuclc      pretvara velika slova u mala\n"

#: src/stty.c:730
msgid ""
" * [-]ixany      let any character restart output, not only start character\n"
msgstr ""
" * [-]ixany      dopušta bilo kojem znaku, ne samo znaku start,\n"
"                 ponovno pokretanje izlaza\n"

#: src/stty.c:734
msgid ""
"   [-]ixoff      enable sending of start/stop characters\n"
"   [-]ixon       enable XON/XOFF flow control\n"
"   [-]parmrk     mark parity errors (with a 255-0-character sequence)\n"
"   [-]tandem     same as [-]ixoff\n"
msgstr ""
"   [-]ixoff      omogućuje slanje znakova 'start/stop'\n"
"   [-]ixon       omogućuje XON/XOFF kontrolu protoka\n"
"   [-]parmrk     označava greške pariteta (slijedom znakova 255 i 0)\n"
"   [-]tandem     isto što i '[-]ixoff'\n"

#: src/stty.c:740
msgid ""
"\n"
"Output settings:\n"
msgstr ""
"\n"
"Postavke izlaza:\n"

#: src/stty.c:745
msgid " * bsN           backspace delay style, N in [0..1]\n"
msgstr " * bsN           način odgode povratnice (backspace), N u [0..1]\n"

#: src/stty.c:750
msgid " * crN           carriage return delay style, N in [0..3]\n"
msgstr " * crN           način odgode povratka na početak (CR), N u [0..3]\n"

#: src/stty.c:755
msgid " * ffN           form feed delay style, N in [0..1]\n"
msgstr " * ffN           način odgode nove stranice (FF), N u [0..1]\n"

#: src/stty.c:760
msgid " * nlN           newline delay style, N in [0..1]\n"
msgstr " * nlN           način odgode novog retka (LF), N u [0..1]\n"

#: src/stty.c:765
msgid " * [-]ocrnl      translate carriage return to newline\n"
msgstr " * [-]ocrnl      pretvara povratak na početak (CR) u novi redak (LF)\n"

#: src/stty.c:770
msgid ""
" * [-]ofdel      use delete characters for fill instead of NUL characters\n"
msgstr ""
" * [-]ofdel      upotrebljava znakove brisanja (DEL) za dopunjavanje\n"
"                 umjesto NUL znakova\n"

#: src/stty.c:775
msgid ""
" * [-]ofill      use fill (padding) characters instead of timing for delays\n"
msgstr ""
" * [-]ofill      upotrebljava znakove za dopunjavanje umjesto vremenski\n"
"                 određenih odgoda\n"

#: src/stty.c:780
msgid " * [-]olcuc      translate lowercase characters to uppercase\n"
msgstr " * [-]olcuc      pretvara mala slova u velika\n"

#: src/stty.c:785
msgid " * [-]onlcr      translate newline to carriage return-newline\n"
msgstr ""
" * [-]onlcr      pretvara novi redak (LF) na početak-novi redak (CRLF)\n"

#: src/stty.c:790
msgid " * [-]onlret     newline performs a carriage return\n"
msgstr " * [-]onlret     novi redak (LF) izvršava i povratak na početak (CR)\n"

#: src/stty.c:795
msgid " * [-]onocr      do not print carriage returns in the first column\n"
msgstr " * [-]onocr      ne ispisuje povratak na početak (CR) u prvom stupcu\n"

#: src/stty.c:799
msgid "   [-]opost      postprocess output\n"
msgstr "   [-]opost      obavlja naknadnu obradu izlaza\n"

#: src/stty.c:803
msgid ""
" * tabN          horizontal tab delay style, N in [0..3]\n"
" * tabs          same as tab0\n"
" * -tabs         same as tab3\n"
msgstr ""
" * tabN          način odgode vodoravnog taba, N u [0..3]\n"
" * tabs          isto što i 'tab0'\n"
" * -tabs         isto što i 'tab3'\n"

#: src/stty.c:810
msgid " * vtN           vertical tab delay style, N in [0..1]\n"
msgstr " * vtN           način odgode okomitog taba, N u [0..1]\n"

#: src/stty.c:814
msgid ""
"\n"
"Local settings:\n"
"   [-]crterase   echo erase characters as backspace-space-backspace\n"
msgstr ""
"\n"
"Lokalne postavke:\n"
"   [-]crterase   odražava znakove brisanja kao povratnica-razmak-povratnica\n"

#: src/stty.c:820
msgid ""
" * crtkill       kill all line by obeying the echoprt and echoe settings\n"
" * -crtkill      kill all line by obeying the echoctl and echok settings\n"
msgstr ""
" * crtkill       briše cijeli redak poštujući postavke echoprt i echoe\n"
" * -crtkill      briše cijeli redak poštujući postavke echoctl i echok\n"

#: src/stty.c:826
msgid " * [-]ctlecho    echo control characters in hat notation ('^c')\n"
msgstr ""
" * [-]ctlecho    odražava upravljačke znakove oznakom s kapićem ('^c')\n"

#: src/stty.c:830
msgid "   [-]echo       echo input characters\n"
msgstr "   [-]echo       odražava ulazne znakove\n"

#: src/stty.c:834
msgid " * [-]echoctl    same as [-]ctlecho\n"
msgstr " * [-]echoctl    isto što i '[-]ctlecho'\n"

#: src/stty.c:838
msgid ""
"   [-]echoe      same as [-]crterase\n"
"   [-]echok      echo a newline after a kill character\n"
msgstr ""
"   [-]echoe      isto što i '[-]crterase'\n"
"   [-]echok      odražava novi redak nakon znaka za brisanje retka\n"

#: src/stty.c:843
msgid " * [-]echoke     same as [-]crtkill\n"
msgstr " * [-]echoke     isto što i '[-]crtkill'\n"

#: src/stty.c:847
msgid "   [-]echonl     echo newline even if not echoing other characters\n"
msgstr ""
"   [-]echonl     odražava novi redak čak i ako ne odražava ostale znakove\n"

#: src/stty.c:851
msgid ""
" * [-]echoprt    echo erased characters backward, between '\\' and '/'\n"
msgstr ""
" * [-]echoprt    odražava izbrisane znakove unatrag, između '\\' i '/'\n"

#: src/stty.c:856
msgid " * [-]extproc    enable \"LINEMODE\"; useful with high latency links\n"
msgstr ""
" * [-]extproc    omogućuje \"LINEMODE\"; korisno kod poveznica\n"
"                 s velikim kašnjenjem\n"

#: src/stty.c:861
msgid " * [-]flusho     discard output\n"
msgstr " * [-]flusho     odbacuje izlaz\n"

#: src/stty.c:865
#, c-format
msgid ""
"   [-]icanon     enable special characters: %s\n"
"   [-]iexten     enable non-POSIX special characters\n"
msgstr ""
"   [-]icanon     omogućuje posebne znakove: %s\n"
"   [-]iexten     omogućuje posebne znakove koji nisu dio standarda POSIX\n"

#: src/stty.c:876
msgid ""
"   [-]isig       enable interrupt, quit, and suspend special characters\n"
"   [-]noflsh     disable flushing after interrupt and quit special "
"characters\n"
msgstr ""
"   [-]isig       omogućuje posebne znakove za prekid, izlaz i obustavu\n"
"   [-]noflsh     onemogućuje pražnjenje nakon posebnih znakova za prekid i "
"izlaz\n"

#: src/stty.c:881
msgid " * [-]prterase   same as [-]echoprt\n"
msgstr " * [-]prterase   isto što i '[-]echoprt'\n"

#: src/stty.c:886
msgid ""
" * [-]tostop     stop background jobs that try to write to the terminal\n"
msgstr ""
" * [-]tostop     zaustavlja pozadinske poslove koji\n"
"                 pokušavaju pisati na terminal\n"

#: src/stty.c:891
msgid ""
" * [-]xcase      with icanon, escape with '\\' for uppercase characters\n"
msgstr " * [-]xcase      s 'icanon', maskira velika slova pomoću '\\'\n"

#: src/stty.c:895
msgid ""
"\n"
"Combination settings:\n"
msgstr ""
"\n"
"Kombinirane postavke:\n"

#: src/stty.c:900
msgid " * [-]LCASE      same as [-]lcase\n"
msgstr " * [-]LCASE      isto što i '[-]lcase'\n"

#: src/stty.c:904
msgid ""
"   cbreak        same as -icanon\n"
"   -cbreak       same as icanon\n"
msgstr ""
"   cbreak        isto što i '-icanon'\n"
"   -cbreak       isto što i 'icanon'\n"

#: src/stty.c:908
msgid ""
"   cooked        same as brkint ignpar istrip icrnl ixon opost isig\n"
"                 icanon, eof and eol characters to their default values\n"
"   -cooked       same as raw\n"
msgstr ""
"   cooked        isto što i 'brkint ignpar istrip icrnl ixon opost isig\n"
"                 icanon'; znakove eof i eol postavlja na zadane vrijednosti\n"
"   -cooked       isto što i 'raw'\n"

#: src/stty.c:913
#, c-format
msgid "   crt           same as %s\n"
msgstr "   crt           isto što i %s\n"

#: src/stty.c:923
#, c-format
msgid ""
"   dec           same as %s intr ^c erase 0177\n"
"                 kill ^u\n"
msgstr ""
"   dec           isto što i '%s intr ^c erase 0177\n"
"                 kill ^u'\n"

#: src/stty.c:938
msgid " * [-]decctlq    same as [-]ixany\n"
msgstr " * [-]decctlq    isto što i '[-]ixany'\n"

#: src/stty.c:942
msgid ""
"   ek            erase and kill characters to their default values\n"
"   evenp         same as parenb -parodd cs7\n"
"   -evenp        same as -parenb cs8\n"
msgstr ""
"   ek            postavlja znakove erase i kill na zadane vrijednosti\n"
"   evenp         isto što i 'parenb -parodd cs7'\n"
"   -evenp        isto što i '-parenb cs8'\n"

#: src/stty.c:948
msgid " * [-]lcase      same as xcase iuclc olcuc\n"
msgstr " * [-]lcase      isto što i 'xcase iuclc olcuc'\n"

#: src/stty.c:952
msgid ""
"   litout        same as -parenb -istrip -opost cs8\n"
"   -litout       same as parenb istrip opost cs7\n"
msgstr ""
"   litout        isto što i '-parenb -istrip -opost cs8'\n"
"   -litout       isto što i 'parenb istrip opost cs7'\n"

#: src/stty.c:956
#, c-format
msgid ""
"   nl            same as %s\n"
"   -nl           same as %s\n"
msgstr ""
"   nl            isto što i %s\n"
"   -nl           isto što i %s\n"

#: src/stty.c:974
msgid ""
"   oddp          same as parenb parodd cs7\n"
"   -oddp         same as -parenb cs8\n"
"   [-]parity     same as [-]evenp\n"
"   pass8         same as -parenb -istrip cs8\n"
"   -pass8        same as parenb istrip cs7\n"
msgstr ""
"   oddp          isto što i 'parenb parodd cs7'\n"
"   -oddp         isto što i '-parenb cs8'\n"
"   [-]parity     isto što i '[-]evenp'\n"
"   pass8         isto što i '-parenb -istrip cs8'\n"
"   -pass8        isto što i 'parenb istrip cs7'\n"

#: src/stty.c:981
#, c-format
msgid ""
"   raw           same as -ignbrk -brkint -ignpar -parmrk -inpck -istrip\n"
"                 -inlcr -igncr -icrnl -ixon -ixoff -icanon -opost\n"
"                 -isig%s min 1 time 0\n"
"   -raw          same as cooked\n"
msgstr ""
"   raw           isto što i '-ignbrk -brkint -ignpar -parmrk -inpck -istrip\n"
"                 -inlcr -igncr -icrnl -ixon -ixoff -icanon -opost\n"
"                 -isig%s min 1 time 0'\n"
"   -raw          isto što i 'cooked'\n"

#: src/stty.c:1000
#, c-format
msgid ""
"   sane          same as cread -ignbrk brkint -inlcr -igncr icrnl\n"
"                 icanon iexten echo echoe echok -echonl -noflsh\n"
"                 %s\n"
"                 %s\n"
"                 %s,\n"
"                 all special characters to their default values\n"
msgstr ""
"   sane          isto što i 'cread -ignbrk brkint -inlcr -igncr icrnl\n"
"                 icanon iexten echo echoe echok -echonl -noflsh\n"
"                 %s\n"
"                 %s\n"
"                 %s',\n"
"                 postavlja sve posebne znakove na zadane vrijednosti\n"

#: src/stty.c:1086
msgid ""
"\n"
"Handle the tty line connected to standard input.  Without arguments,\n"
"prints baud rate, line discipline, and deviations from stty sane.  In\n"
"settings, CHAR is taken literally, or coded as in ^c, 0x37, 0177 or\n"
"127; special values ^- or undef used to disable special characters.\n"
msgstr ""
"\n"
"Upravlja tty linijom spojenom na standardni ulaz. Bez argumenata,\n"
"ispisuje brzinu prijenosa, disciplinu linije i odstupanja od 'stty sane'.\n"
"U postavkama se ZNAK uzima doslovno ili kodiran kao ^c, 0x37, 0177 ili\n"
"127; posebne vrijednosti ^- ili 'undef' služe za onemogućavanje posebnih\n"
"znakova.\n"

