msgstr "%s: spustiti se u direktorij %s zaštićen od pisanja? "

#: src/remove.c:279
#, c-format
msgid "%s: descend into directory %s? "
msgstr "%s: spustiti se u direktorij %s? "

#: src/remove.c:298
#, c-format
