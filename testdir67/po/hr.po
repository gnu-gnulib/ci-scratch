msgstr "Postavlja svako IME na VRIJEDNOST u okruženju i izvršava NAREDBU.\n"

#: src/env.c:147
msgid ""
"  -a, --argv0=ARG\n"
"         pass ARG as the zeroth argument of COMMAND\n"
msgstr ""
"  -a, --argv0=ARG\n"
"         prosljeđuje ARG kao nulti argument NAREDBE\n"

#: src/env.c:151
msgid ""
"  -i, --ignore-environment\n"
"         start with an empty environment\n"
msgstr ""
"  -i, --ignore-environment\n"
"         započinje s praznim okruženjem\n"

#: src/env.c:155
#, fuzzy
msgid ""
"      --env0-from=FILE\n"
"         read NUL-delimited environment entries from FILE\n"
msgstr ""
"      --random-source=DATOTEKA\n"
"         dohvaća nasumične bajtove iz DATOTEKE\n"

#: src/env.c:163
msgid ""
"  -u, --unset=NAME\n"
"         remove variable from the environment\n"
msgstr ""
"  -u, --unset=IME\n"
"         uklanja varijablu IME iz okruženja\n"

#: src/env.c:167
msgid ""
"  -C, --chdir=DIR\n"
"         change working directory to DIR\n"
msgstr ""
"  -C, --chdir=DIREKTORIJ\n"
"         mijenja radni direktorij u DIREKTORIJ\n"

#: src/env.c:171
msgid ""
"  -S, --split-string=S\n"
"         process and split S into separate arguments;\n"
"         used to pass multiple arguments on shebang lines\n"
msgstr ""
"  -S, --split-string=S\n"
"         obrađuje i dijeli S na zasebne argumente;\n"
"         koristi se za prosljeđivanje više argumenata u 'shebang' redcima\n"

#: src/env.c:176
msgid ""
"      --block-signal[=SIG]\n"
"         block delivery of SIG signal(s) to COMMAND\n"
msgstr ""
"      --block-signal[=SIG]\n"
"         blokira isporuku signala SIG NAREDBI\n"

#: src/env.c:180
msgid ""
"      --default-signal[=SIG]\n"
"         reset handling of SIG signal(s) to the default\n"
msgstr ""
"      --default-signal[=SIG]\n"
"         vraća obradu signala SIG na zadano\n"

#: src/env.c:184
msgid ""
"      --ignore-signal[=SIG]\n"
"         set handling of SIG signal(s) to do nothing\n"
msgstr ""
"      --ignore-signal[=SIG]\n"
"         postavlja obradu signala SIG na zanemarivanje\n"

#: src/env.c:188
msgid ""
"      --list-signal-handling\n"
"         list non default signal handling to standard error\n"
msgstr ""
"      --list-signal-handling\n"
"         ispisuje nezadanu obradu signala na standardnu grešku\n"

#: src/env.c:192
msgid ""
"  -v, --debug\n"
"         print verbose information for each processing step\n"
msgstr ""
"  -v, --debug\n"
"         ispisuje opširne podatke za svaki korak obrade\n"

#: src/env.c:198
msgid ""
"\n"
"A mere - implies -i.  If no COMMAND, print the resulting environment.\n"
msgstr ""
"\n"
"Sam '-' podrazumijeva '-i'. Bez NAREDBE, ispisuje rezultirajuće okruženje.\n"

#: src/env.c:202
msgid ""
"\n"
"SIG may be a signal name like 'PIPE', or a signal number like '13'.\n"
"Without SIG, all known signals are included.  Multiple signals can be\n"
"comma-separated.  An empty SIG argument is a no-op.\n"
msgstr ""
"\n"
"SIG može biti naziv signala (npr. 'PIPE') ili broj signala (npr. '13').\n"
"Bez SIG-a uključeni su svi poznati signali. Više signala može se\n"
"odvojiti zarezom. Prazni argument SIG nema učinka.\n"

