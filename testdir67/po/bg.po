#: src/chcon.c:364
#, c-format
msgid ""
"Usage: %s [OPTION]... CONTEXT FILE...\n"
"  or:  %s [OPTION]... [-u USER] [-r ROLE] [-l RANGE] [-t TYPE] FILE...\n"
"  or:  %s [OPTION]... --reference=RFILE FILE...\n"
msgstr ""
"Употреба: %s [ОПЦИЯ]… КОНТЕКСТ ФАЙЛ…\n"
"     или: %s [ОПЦИЯ]… [-u ПОТРЕБИТЕЛ] [-r РОЛЯ] [-l ДИАПАЗОН] [-t ВИД] "
"ФАЙЛ…\n"
"     или: %s [ОПЦИЯ]… --reference=ФАЙЛ_ЕТАЛОН ФАЙЛ…\n"

#: src/chcon.c:370
msgid ""
"Change the SELinux security context of each FILE to CONTEXT.\n"
"With --reference, change the security context of each FILE to that of "
"RFILE.\n"
msgstr ""
"Задаване на този КОНТЕКСТ на SELinux за сигурност на всеки ФАЙЛ.  С опцията\n"
"„--reference“ се използва контекстът за сигурност от ФАЙЛа_ЕТАЛОН.\n"

#: src/chcon.c:377 src/chown.c:110
msgid ""
"      --dereference\n"
"         affect the referent of each symbolic link (this is\n"
"         the default), rather than the symbolic link itself\n"
msgstr ""
"      --dereference работа с обекта, сочен от символната връзка, а не с нея\n"
"                    (стандартно)\n"

#: src/chcon.c:382
msgid ""
"  -h, --no-dereference\n"
"         affect symbolic links instead of any referenced file\n"
msgstr ""
"  -h, --no-dereference\n"
"                    работа със самата символна връзка, а не със сочения от\n"
"                    нея обект\n"

#: src/chcon.c:386
msgid ""
"  -u, --user=USER\n"
"         set user USER in the target security context\n"
msgstr ""
"  -u, --user=ПОТРЕБИТЕЛ\n"
"                    задаване на този ПОТРЕБИТЕЛ в целевия контекст\n"

#: src/chcon.c:390
msgid ""
"  -r, --role=ROLE\n"
"         set role ROLE in the target security context\n"
msgstr "  -r, --role=РОЛЯ   задаване на тази РОЛЯ в целевия контекст\n"

#: src/chcon.c:394
msgid ""
"  -t, --type=TYPE\n"
"         set type TYPE in the target security context\n"
msgstr "  -t, --type=ВИД    задаване на този ВИД в целевия контекст\n"

#: src/chcon.c:398
msgid ""
"  -l, --range=RANGE\n"
"         set range RANGE in the target security context\n"
msgstr ""
"  -l, --range=ДИАПАЗОН\n"
"                    задаване на този ДИАПАЗОН в целевия контекст\n"

#: src/chcon.c:402 src/chmod.c:466 src/chown.c:127
msgid ""
"      --no-preserve-root\n"
"         do not treat '/' specially (the default)\n"
msgstr ""
"      --no-preserve-root\n"
"                    без специално третиране на „/“ (стандартно)\n"

#: src/chcon.c:406 src/chmod.c:470 src/chown.c:131
msgid ""
"      --preserve-root\n"
"         fail to operate recursively on '/'\n"
msgstr ""
"      --preserve-root\n"
"                    без рекурсивна работа в „/“\n"

#: src/chcon.c:410
msgid ""
"      --reference=RFILE\n"
"         use RFILE's security context rather than specifying a CONTEXT "
"value\n"
msgstr ""
"      --reference=ФАЙЛ_ЕТАЛОН\n"
"                    използване на контекста от този ФАЙЛ_ЕТАЛОН вместо "
"изрично\n"
"                    задаване\n"

#: src/chcon.c:414 src/chown.c:140
msgid ""
"  -R, --recursive\n"
"         operate on files and directories recursively\n"
msgstr "  -R, --recursive   рекурсивна работа с директориите\n"

#: src/chcon.c:418 src/chmod.c:453 src/chown.c:106
msgid ""
"  -v, --verbose\n"
