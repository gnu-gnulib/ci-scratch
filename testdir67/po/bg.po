msgstr "%s: номерът на ред е извън диапазона"

#: src/csplit.c:669
#, c-format
msgid "%s: %s: line number out of range"
msgstr "%s: %s: номерът на ред е извън диапазона"

#: src/csplit.c:672 src/csplit.c:727
#, c-format
