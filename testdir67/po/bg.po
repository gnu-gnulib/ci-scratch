#: src/shuf.c:56
#, c-format
msgid ""
"Usage: %s [OPTION]... [FILE]\n"
"  or:  %s -e [OPTION]... [ARG]...\n"
"  or:  %s -i LO-HI [OPTION]...\n"
msgstr ""
"Употреба: %s [ОПЦИЯ]… [ФАЙЛ]\n"
"     или: %s -e [ОПЦИЯ]… [АРГУМЕНТ]…\n"
"     или: %s -i ОТ-ДО [ОПЦИЯ]…\n"

#: src/shuf.c:62
msgid "Write a random permutation of the input lines to standard output.\n"
msgstr ""
"Запис на случайна пермутация на входните редове на стандартния изход.\n"

#: src/shuf.c:69
msgid "  -e, --echo                treat each ARG as an input line\n"
msgstr "  -e, --echo        всеки АРГУМЕНТ се интерпретира като входен ред\n"

#: src/shuf.c:72
msgid ""
"  -i, --input-range=LO-HI   treat each number LO through HI as an input "
"line\n"
msgstr ""
"  -i, --input-range=ОТ-ДО\n"
"                    всяко число ОТ-ДО се интерпретира като входен ред\n"

#: src/shuf.c:75
msgid "  -n, --head-count=COUNT    output at most COUNT lines\n"
msgstr ""
"  -n, --head-lines=БРОЙ\n"
"                    извеждане на максимално този БРОЙ редове\n"

#: src/shuf.c:78
msgid ""
"  -o, --output=FILE         write result to FILE instead of standard output\n"
msgstr ""
"  -o, --output=ФАЙЛ\n"
"                    извеждане във ФАЙЛа вместо на стандартния изход\n"

#: src/shuf.c:81
msgid "      --random-source=FILE  get random bytes from FILE\n"
msgstr ""
"      --random-source=ФАЙЛ\n"
"                    случайни байтове от този ФАЙЛ, а не „/dev/urandom“\n"

#: src/shuf.c:84
msgid "  -r, --repeat              output lines can be repeated\n"
msgstr "  -r, --repeat      позволяване на повторения в изведените редове\n"

#: src/shuf.c:87
msgid "  -z, --zero-terminated     line delimiter is NUL, not newline\n"
msgstr ""
"  -z, --zero-terminated\n"
"                    завършване на редовете с нулев байт, а не с нов ред\n"

#: src/shuf.c:227
#, c-format
msgid "too many input lines"
msgstr "прекалено много входни редове"

#: src/shuf.c:431
#, c-format
msgid "multiple -i options specified"
msgstr "указани са повече от една опции „-i“"

#: src/shuf.c:460
msgid "invalid input range"
msgstr "неправилен входен диапазон"

#: src/shuf.c:472
#, c-format
msgid "invalid line count: %s"
msgstr "нeправилен брой редове: %s"

#: src/shuf.c:479 src/sort.c:4877
#, c-format
msgid "multiple output files specified"
msgstr "указани са множество изходни файлове"

#: src/shuf.c:509
#, c-format
msgid "cannot combine -e and -i options"
msgstr "опциите „-e“ и „-i“ са несъвместими"

#: src/shuf.c:599
#, c-format
msgid "no lines to repeat"
msgstr "няма редове за повтаряне"

#: src/sleep.c:42
#, c-format
msgid ""
"Usage: %s NUMBER[SUFFIX]...\n"
"  or:  %s OPTION\n"
"Pause for NUMBER seconds, where NUMBER is an integer or floating-point.\n"
"SUFFIX may be 's','m','h', or 'd', for seconds, minutes, hours, days.\n"
"With multiple arguments, pause for the sum of their values.\n"
"\n"
msgstr ""
"Употреба: %s БРОЙ[СУФИКС]…\n"
"     или: %s ОПЦИЯ\n"
"Пауза от такъв БРОЙ секунди. БРОят може да цяло число или число с плаваща\n"
"запетая.  СУФИКСът може да бъде „s“ за секунди, „m“ за минути, „h“ за "
"часове\n"
"или „d“ за дни.  При повече от един аргументи се чака сумата от посочените\n"
"времена.\n"
"\n"

#: src/sleep.c:131 src/timeout.c:386
#, c-format
msgid "invalid time interval %s"
msgstr "неправилен интервал за време „%s“"

#: src/sleep.c:142 src/tail.c:1345
#, c-format
msgid "cannot read realtime clock"
msgstr "часовникът в реално време не може да се чете"

#: src/sort.c:436
msgid "Write sorted concatenation of all FILE(s) to standard output.\n"
msgstr ""
"Извеждане на подреденото обединено съдържание на всички ФАЙЛ(ове) на\n"
"стандартния изход\n"

#: src/sort.c:443
msgid ""
"Ordering options:\n"
"\n"
msgstr ""
"Опции за подредба:\n"
"\n"

#: src/sort.c:447
msgid ""
"  -b, --ignore-leading-blanks\n"
"         ignore leading blanks when finding sort keys in each line\n"
msgstr ""
"  -b, --ignore-leading-blanks\n"
"                    без отчитане на интервалите в началото при търсене на\n"
"                    ключовете за подредбата\n"

#: src/sort.c:451
msgid ""
"  -d, --dictionary-order\n"
"         consider only blanks and alphanumeric characters\n"
msgstr ""
"  -d, --dictionary-order\n"
"                    отчитане само на интервалите и буквено-цифровите знаци\n"

#: src/sort.c:455
msgid ""
"  -f, --ignore-case\n"
"         fold lower case to upper case characters\n"
msgstr ""
"  -f, --ignore-case\n"
"                    без разлика между главни и малки букви\n"

#: src/sort.c:459
msgid ""
"  -g, --general-numeric-sort\n"
"         compare according to general numerical value\n"
msgstr ""
"  -g, --general-numeric-sort\n"
"                    подредба като числа\n"

#: src/sort.c:463
msgid ""
"  -i, --ignore-nonprinting\n"
"         consider only printable characters\n"
msgstr ""
"  -i, --ignore-nonprinting\n"
"                    подредба само по видимите знаци, а не интервалите\n"

#: src/sort.c:467
msgid ""
"  -M, --month-sort\n"
"         compare (unknown) < 'JAN' < ... < 'DEC'\n"
msgstr ""
"  -M, --month-sort\n"
"                    подредба като месеци: (друго) < „ЯНУ“ < … < “ДЕК“\n"

#: src/sort.c:471
msgid ""
"  -h, --human-numeric-sort\n"
"         compare human readable numbers (e.g., 2K 1G)\n"
msgstr ""
"  -h, --human-numeric-sort\n"
"                    „човешка“ подредба (със зачитане на 2K, 1G…)\n"

#: src/sort.c:475
msgid ""
"  -n, --numeric-sort\n"
"         compare according to string numerical value;\n"
"         see full documentation for supported strings\n"
msgstr ""
"  -n, --numeric-sort\n"
"                    подредба според числовата стойност на низовете вижте\n"
"                    документация за поддържаните низове\n"

#: src/sort.c:480
msgid ""
"  -R, --random-sort\n"
"         shuffle, but group identical keys.  See also shuf(1)\n"
msgstr ""
"  -R, --random-sort случайна подредба с групиране на еднаквите ключове\n"
"                    (вж. „shuf(1)“)\n"

#: src/sort.c:488
msgid ""
"  -r, --reverse\n"
"         reverse the result of comparisons\n"
msgstr "  -r, --reverse     подредба в обратен ред\n"

#: src/sort.c:492
msgid ""
"      --sort=WORD\n"
"         sort according to WORD:\n"
"           general-numeric -g, human-numeric -h, month -M,\n"
"           numeric -n, random -R, version -V\n"
msgstr ""
"      --sort=ДУМА   подредба според ДУМАта:\n"
"                    ⁃ „general-numeric“≡„-g“;\n"
"                    ⁃ „human-numeric“≡„-h“;\n"
"                    ⁃ „month“≡„-M“;\n"
"                    ⁃ „numeric“≡„-n“;\n"
"                    ⁃ „random“≡„-R“;\n"
"                    ⁃ „version“≡„-V“.\n"

#: src/sort.c:498
msgid ""
"  -V, --version-sort\n"
"         natural sort of (version) numbers within text\n"
msgstr ""
"  -V, --version-sort\n"
"                    естествена подредба като числа-версии\n"
"\n"

#: src/sort.c:502
msgid ""
"\n"
"Other options:\n"
"\n"
msgstr ""
"\n"
"Други опции:\n"
"\n"

#: src/sort.c:507
msgid ""
"      --batch-size=NMERGE\n"
"         merge at most NMERGE inputs at once; for more use temp files\n"
msgstr ""
"      --batch-size=БРОЙ\n"
"                    сливане на максимално такъв БРОЙ входа наведнъж, за "
"повече\n"
"                    да се ползват временни файлове\n"

#: src/sort.c:511
msgid ""
"  -c, --check, --check=diagnose-first\n"
"         check for sorted input; do not sort\n"
msgstr ""
"  -c, --check, --check=diagnose-first\n"
"                    само се проверява дали входните данни са подредени, без\n"
"                    подредба\n"

#: src/sort.c:515
msgid ""
"  -C, --check=quiet, --check=silent\n"
"         like -c, but do not report first bad line\n"
msgstr ""
"  -C, --check=quiet, --check=silent\n"
"                    като „-c“, но без извеждане на първия сгрешен ред\n"

#: src/sort.c:519
msgid ""
"      --compress-program=PROG\n"
"         compress temporaries with PROG; decompress them with PROG -d\n"
msgstr ""
"      --compress-program=ПРОГРАМА\n"
"                    компресиране на временните резултати с тази ПРОГРАМА,\n"
"                    декомпресиране с: „ПРОГРАМАта -d“\n"

#: src/sort.c:523
msgid ""
"      --debug\n"
"         annotate the part of the line used to sort,\n"
"         and warn about questionable usage to standard error\n"
msgstr ""
"      --debug       анотиране на частта от реда, използвана за подредбата и\n"
"                    предупреждаване за неправилна употреба на стандартната\n"
"                    грешка\n"

#: src/sort.c:528
msgid ""
"      --files0-from=F\n"
"         read input from the files specified by NUL-terminated names in file "
"F;\n"
"         If F is -, read names from standard input\n"
msgstr ""
"      --files0-from=ФАЙЛ\n"
"                    четене на файловете, чиито имена са изредени в този "
"ФАЙЛ,\n"
"                    като всяко име завършва с нулев байт.  Ако ФАЙЛът е "
"„-“,\n"
"                    се чете от стандартния вход\n"

#: src/sort.c:534
msgid ""
"  -k, --key=KEYDEF\n"
"         sort via a key; KEYDEF gives location and type\n"
msgstr "  -k, --key=КЛЮЧ    подредба според мястото и вида на дадения КЛЮЧ\n"

#: src/sort.c:538
msgid ""
"  -m, --merge\n"
"         merge already sorted files; do not sort\n"
msgstr ""
"  -m, --merge       сливане на вече подредени файлове, не се извършва\n"
"                    допълнително подреждане\n"

#: src/sort.c:542
msgid ""
"  -o, --output=FILE\n"
"         write result to FILE instead of standard output\n"
msgstr ""
"  -o, --output=ФАЙЛ запазване на резултата във ФАЙЛа вместо на стандартния "
"изход\n"

#: src/sort.c:546
msgid ""
"  -s, --stable\n"
"         stabilize sort by disabling last-resort comparison\n"
msgstr ""
"  -s, --stable      стабилна подредба, прескачане на последната/резервната\n"

#: src/sort.c:550
msgid ""
"  -S, --buffer-size=SIZE\n"
"         use SIZE for main memory buffer\n"
msgstr ""
"  -S, --buffer-size=РАЗМЕР\n"
"                    използване на буфер в паметта с този РАЗМЕР\n"

#: src/sort.c:554
msgid ""
"  -t, --field-separator=SEP\n"
"         use SEP instead of non-blank to blank transition\n"
msgstr ""
"  -t, --field-separator=РАЗДЕЛИТЕЛ\n"
"                    използване на този РАЗДЕЛИТЕЛ вместо преход от видим "
"знак\n"
"                    към интервал\n"

#: src/sort.c:558
#, c-format
msgid ""
"  -T, --temporary-directory=DIR\n"
"         use DIR for temporaries, not $TMPDIR or %s;\n"
"         multiple options specify multiple directories\n"
msgstr ""
"  -T, --temporary-directory=ДИРЕКТОРИЯ\n"
"                    използване на тази ДИРЕКТОРИЯ директория за временни "
"файлове\n"
"                    вместо „$TMPDIR“ или „%s“.  Задайте няколко такива\n"
"                    опции за няколко директории\n"

#: src/sort.c:563
msgid ""
"      --parallel=N\n"
"         change the number of sorts run concurrently to N\n"
msgstr ""
"      --parallel=БРОЙ\n"
"                    ползване на този БРОЙ паралелни подредби\n"

#: src/sort.c:567
msgid ""
"  -u, --unique\n"
"         output only the first of lines with equal keys;\n"
"         with -c, check for strict ordering\n"
msgstr ""
"  -u, --unique      извежда само първият от група еквивалентни редове, с „-"
"c“ —\n"
"                    проверка за строга наредба\n"

#: src/sort.c:578
msgid ""
"\n"
"KEYDEF is F[.C][OPTS][,F[.C][OPTS]] for start and stop position, where F is "
"a\n"
"field number and C a character position in the field; both are origin 1, "
"and\n"
"the stop position defaults to the line's end.  If neither -t nor -b is in\n"
"effect, characters in a field are counted from the beginning of the "
"preceding\n"
"whitespace.  OPTS is one or more single-letter ordering options "
"[bdfgiMhnRrV],\n"
"which override global ordering options for that key.  If no key is given, "
"use\n"
"the entire line as the key.  Use --debug to diagnose incorrect key usage.\n"
"\n"
"SIZE may be followed by the following multiplicative suffixes:\n"
msgstr ""
"\n"
"КЛЮЧът е ПОЛЕ[.ЗНАК][ОПЦИИ][,ПОЛЕ[.ЗНАК][ОПЦИИ]] за началната и крайната\n"
"позиции, където номерът на ПОЛЕто и мястото на ЗНАКа в полето се броят от "
"1.\n"
"Когато не е указан край се използва редът до края му, а ако не е зададен "
"КЛЮЧ,\n"
"се използва целият ред.  Ако не е зададена някоя от опциите „-t“ и „-b“,\n"
"знаците в полето се броят от началото на предхождащото бяло поле.  ОПЦИИте "
"са\n"
"подмножество на „bdfgiMhnRrV“ и задават подредбата с приоритет пред "
"глобалните\n"
"опции за наредба на това поле.\n"
"\n"
"РАЗМЕРът може да бъде следван от някой от следните множители:\n"

#: src/sort.c:591
msgid ""
"% 1% of memory, b 1, K 1024 (default), and so on for M, G, T, P, E, Z, Y, R, "
"Q.\n"
"\n"
"*** WARNING ***\n"
"The locale specified by the environment affects sort order.\n"
"Set LC_ALL=C to get the traditional sort order that uses\n"
"native byte values.\n"
msgstr ""
"% 1% от паметта, b 1, K 1024 (стандартно) и т.н. за M, G, T, P, E, Z, Y, R, "
"Q.\n"
"\n"
"••• ПРЕДУПРЕЖДЕНИЕ •••\n"
"Локалът, посочен в обкръжението, влияе на подредбата!\n"
"Използвайте LC_ALL=C, за да получите традиционната, при която се сравнява "
"според\n"
"стойността на байтовете.\n"

#: src/sort.c:778
#, c-format
msgid "waiting for %s [-d]"
msgstr "изчакване на „%s“ [-d]"

#: src/sort.c:783
#, c-format
msgid "%s [-d] terminated abnormally"
msgstr "„%s“ [-d] бе прекратен неочаквано"

#: src/sort.c:926
#, c-format
msgid "cannot create temporary file in %s"
msgstr "не може да се създаде временен файл в „%s“"

#: src/sort.c:1041 src/sort.c:2424 src/sort.c:3545 src/sort.c:4188
#: src/sort.c:4279 src/sort.c:4282
msgid "open failed"
msgstr "неуспешно отваряне"

#: src/sort.c:1060
msgid "fflush failed"
msgstr "неуспешно изчистване на буферите с „fflush“"

#: src/sort.c:1065 src/sort.c:2427 src/sort.c:5151
msgid "close failed"
msgstr "неуспешно затваряне"

#: src/sort.c:1271
#, c-format
msgid "could not run compress program %s"
msgstr "програмата за компресиране „%s“ не може да се изпълни"

#: src/sort.c:1288
msgid "couldn't create temporary file"
msgstr "неуспешно създаване на временен файл"

#: src/sort.c:1328
#, c-format
msgid "could not run compress program %s -d"
msgstr "програмата за компресиране „%s -d“ не може да се изпълни"

#: src/sort.c:1389
#, c-format
msgid "warning: cannot remove: %s"
msgstr "ПРЕДУПРЕЖДЕНИЕ: „%s“ не може да се изтрие"

#: src/sort.c:1473
#, c-format
msgid "invalid --%s argument %s"
msgstr "неправилен аргумент „%2$s“ за опцията „--%1$s“"

#: src/sort.c:1476
#, c-format
msgid "minimum --%s argument is %s"
msgstr "минималният аргумент за опцията „--%s“ е „%s“"

#: src/sort.c:1490
#, c-format
msgid "--%s argument %s too large"
msgstr "аргументът „%2$s“ за опцията „--%1$s“ е прекалено голям"

#: src/sort.c:1493
#, c-format
msgid "maximum --%s argument with current rlimit is %u"
msgstr ""
"максималният аргумент, който опцията „--%s“ с текущото ограничение rlimit е: "
"%u"

#: src/sort.c:1569
#, c-format
msgid "number in parallel must be nonzero"
msgstr "паралелността не може да е 0"

#: src/sort.c:1719
msgid "stat failed"
msgstr "неуспешно изпълнение на „stat“"

#: src/sort.c:2061
msgid "read failed"
msgstr "неуспешно прочитане"

#: src/sort.c:2443
#, c-format
msgid "string transformation failed"
msgstr "неуспешно преобразуване на низове"

#: src/sort.c:2446
#, c-format
msgid "the original string was %s"
msgstr "първоначалният низ бе „%s“"

#: src/sort.c:2609
#, c-format
msgid "^ no match for key\n"
msgstr "↑ няма съвпадение по ключа\n"

#: src/sort.c:2796
#, c-format
msgid "obsolescent key %s used; consider %s instead"
msgstr "използваният ключ „%s“ е остарял, заменете го с „%s“"

#: src/sort.c:2803
#, c-format
msgid "key %lu has zero width and will be ignored"
msgstr "ключ №%lu е с нулева дължина и се прескача"

#: src/sort.c:2812
#, c-format
msgid "leading blanks are significant in key %lu; consider also specifying 'b'"
msgstr ""
"водещите интервали се значими за ключ №%lu.  Може да укажете и опцията „b“"

#: src/sort.c:2826
#, c-format
msgid "key %lu is numeric and spans multiple fields"
msgstr "ключ №%lu е число и заема няколко полета"

#: src/sort.c:2861
#, c-format
msgid "field separator %s is treated as a group separator in numbers"
msgstr ""
"разделителят на полета „%s“ се обработва като разделител на групи в число"

#: src/sort.c:2874
#, c-format
msgid "field separator %s is treated as a decimal point in numbers"
msgstr ""
"разделителят на полета „%s“ се обработва като десетична запетая в число"

#: src/sort.c:2882
#, c-format
msgid "field separator %s is treated as a minus sign in numbers"
msgstr "разделителят на полета „%s“ се обработва като отрицателен знак в число"

#: src/sort.c:2889
#, c-format
msgid "field separator %s is treated as a plus sign in numbers"
msgstr "разделителят на полета „%s“ се обработва като положителен знак в число"

#: src/sort.c:2901
#, c-format
msgid "numbers use %s as a decimal point in this locale"
msgstr "числата ползват „%s“ като десетична запетая в този локал"

#: src/sort.c:2909
#, c-format
msgid "the multi-byte number group separator in this locale is not supported"
msgstr "в този локал не се поддържа многобайтов разделител на групи в числа"

#: src/sort.c:2925
#, c-format
msgid "option '-%s' is ignored"
msgid_plural "options '-%s' are ignored"
msgstr[0] "опцията „-%s“ се прескача"
msgstr[1] "опциите „-%s“ се прескачат"

#: src/sort.c:2931
#, c-format
msgid "option '-r' only applies to last-resort comparison"
msgstr "опцията „-r“ се отнася само за последната (резервна) подредба"

#: src/sort.c:3208 src/sort.c:3217
msgid "write failed"
msgstr "неуспешен запис"

#: src/sort.c:3259
#, c-format
msgid "%s: %s:%ju: disorder: "
msgstr "%s: %s:%ju: разбърканост: "

#: src/sort.c:3261
msgid "standard error"
msgstr "стандартна грешка"

#: src/sort.c:4172
msgid "cannot read"
msgstr "не може да се прочете"

#: src/sort.c:4462
#, c-format
msgid "%s: invalid field specification %s"
msgstr "%s: неправилно указано поле — „%s“"

#: src/sort.c:4471
#, c-format
msgid "options '-%s' are incompatible"
msgstr "опциите „-%s“ са несъвместими"

#: src/sort.c:4519
#, c-format
msgid "%s: invalid count at start of %s"
msgstr "%s: грешен номер на ред в началото на „%s“"

#: src/sort.c:4741
msgid "invalid number after '-'"
msgstr "грешно число след „--“"

#: src/sort.c:4744 src/sort.c:4830 src/sort.c:4858
msgid "invalid number after '.'"
msgstr "грешно число след „.“"

#: src/sort.c:4757 src/sort.c:4863
msgid "stray character in field spec"
msgstr "излишен знак в указателя на поле"

#: src/sort.c:4804
#, c-format
msgid "multiple compress programs specified"
msgstr "указани са множество програми за компресиране"

#: src/sort.c:4821
msgid "invalid number at field start"
msgstr "неправилно число в началото на поле"

#: src/sort.c:4825 src/sort.c:4853
msgid "field number is zero"
msgstr "номерът на поле е 0"

#: src/sort.c:4834
msgid "character offset is zero"
msgstr "отместването по знак е 0"

#: src/sort.c:4849
msgid "invalid number after ','"
msgstr "неправилно число след „.“"

#: src/sort.c:4899
#, c-format
msgid "empty tab"
msgstr "празна табулация"

#: src/sort.c:4987 src/wc.c:907
#, c-format
msgid "cannot read file names from %s"
msgstr "имената на файловете не може да се прочетат от „%s“"

#: src/sort.c:5010
#, c-format
msgid "%s:%lu: invalid zero-length file name"
msgstr "„%s:%lu“: име с нулева дължина е неправилно за файл"

#: src/sort.c:5016
#, c-format
msgid "no input from %s"
msgstr "няма вход от „%s“"

#: src/sort.c:5069
#, c-format
msgid "text ordering performed using %s sorting rules"
msgstr "подредба според правилата „%s“"

#: src/sort.c:5073
msgid "text ordering performed using simple byte comparison"
msgstr "подредба чрез побайтово сравнение"

#: src/sort.c:5105
#, c-format
msgid "extra operand %s not allowed with -%c"
msgstr "опцията „-%2$c“ е несъвместима с допълнителния операнд „%1$s“"

#: src/split.c:210
#, c-format
msgid "the suffix length needs to be at least %d"
msgstr "дължината на суфикса трябва да е поне %d"

#: src/split.c:226
#, c-format
msgid "Usage: %s [OPTION]... [FILE [PREFIX]]\n"
msgstr "Употреба: %s [ОПЦИЯ]… [ФАЙЛ[ПРЕФИКС]]\n"

#: src/split.c:230
msgid ""
"Output pieces of FILE to PREFIXaa, PREFIXab, ...;\n"
"default size is 1000 lines, and default PREFIX is 'x'.\n"
msgstr ""
"Разделяне на ВХОДа на парчета ПРЕФИКСaa, ПРЕФИКСab,… с фиксиран размер.\n"
"Стандартно ПРЕФИКСът е „x“, а размерът — 1000 реда.\n"

#: src/split.c:238
#, c-format
msgid ""
"  -a, --suffix-length=N\n"
"         generate suffixes of length N (default %d)\n"
msgstr ""
"  -a, --suffix-length=ДЪЛЖИНА\n"
"                    суфиксите да са с тази ДЪЛЖИНА (стандартно — %d)\n"

#: src/split.c:242
msgid ""
"      --additional-suffix=SUFFIX\n"
"         append an additional SUFFIX to file names\n"
msgstr ""
"      --additional-suffix=СУФИКС\n"
"                    добавяне на този СУФИКС към имената на файловете\n"

#: src/split.c:246
msgid ""
"  -b, --bytes=SIZE\n"
"         put SIZE bytes per output file\n"
msgstr ""
"  -b, --bytes=БАЙТОВЕ\n"
"                    изходните файлове да съдържат този брой БАЙТОВЕ\n"

#: src/split.c:250
msgid ""
"  -C, --line-bytes=SIZE\n"
"         put at most SIZE bytes of records per output file\n"
msgstr ""
"  -C, --line-bytes=РАЗМЕР\n"
"                    включване на записи с максимално този кумулативен размер "
"във\n"
"                    всеки изходен файл\n"

#: src/split.c:254
msgid ""
"  -d\n"
"         use numeric suffixes starting at 0, not alphabetic\n"
msgstr "  -d                десетични суфикси, почващи от 0\n"

#: src/split.c:258
msgid ""
"      --numeric-suffixes[=FROM]\n"
"         same as -d, but allow setting the start value\n"
msgstr ""
"      --numeric-suffixes[=НАЧАЛО]\n"
"                    като „-d“, но може да зададете НАЧАЛОто\n"

#: src/split.c:262
msgid ""
"  -x\n"
"         use hex suffixes starting at 0, not alphabetic\n"
msgstr "  -x                шестнадесетични суфикси, почващи от 0\n"

#: src/split.c:266
msgid ""
"      --hex-suffixes[=FROM]\n"
"         same as -x, but allow setting the start value\n"
msgstr ""
"      --hex-suffixes[=НАЧАЛО]\n"
"                    като „-x“, но може да зададете НАЧАЛОто\n"

#: src/split.c:270
msgid ""
"  -e, --elide-empty-files\n"
"         do not generate empty output files with '-n'\n"
msgstr ""
"  -e, --elide-empty-files\n"
"                    без генериране на празни изходни файлове при ползване "
"на\n"
"                    „-n“\n"

#: src/split.c:274
msgid ""
"      --filter=COMMAND\n"
"         write to shell COMMAND; file name is $FILE\n"
msgstr ""
"      --filter=КОМАНДА\n"
"                    запис към тази КОМАНДА, името на файл е „$FILE“\n"

#: src/split.c:278
msgid ""
"  -l, --lines=NUMBER\n"
"         put NUMBER lines/records per output file\n"
msgstr ""
"  -l, --lines=БРОЙ  извеждане на този БРОЙ редове/записи в изходен файл\n"

#: src/split.c:282
msgid ""
"  -n, --number=CHUNKS\n"
"         generate CHUNKS output files; see explanation below\n"
msgstr ""
"  -n, --number=БРОЙ извеждане на този БРОЙ изходни файлове, вж. по-долу\n"

#: src/split.c:286
msgid ""
"  -t, --separator=SEP\n"
"         use SEP instead of newline as the record separator;\n"
"         '\\0' (zero) specifies the NUL character\n"
msgstr ""
"  -t, --separator=РАЗДЕЛИТЕЛ\n"
"                    разделяне на записите с този РАЗДЕЛИТЕЛ вместо нов ред, "
"за\n"
"                    нулев байт използвайте „\\0“\n"

#: src/split.c:291
msgid ""
"  -u, --unbuffered\n"
