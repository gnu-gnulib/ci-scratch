"стандартни\n"
"изход\n"

#: src/fold.c:87
msgid ""
"  -b, --bytes\n"
"         count bytes rather than columns\n"
msgstr "  -b, --bytes       броене на байтовете вместо колоните\n"

#: src/fold.c:91
msgid ""
"  -c, --characters\n"
"         count characters rather than columns\n"
msgstr "  -c, --characters  броене на знаците вместо колоните\n"

#: src/fold.c:95
msgid ""
"  -s, --spaces\n"
"         break after blanks, or in words greater than WIDTH\n"
msgstr ""
"  -s, --spaces      пренасяне на ред след празни знаци или в думи с дължина\n"
"                    по-голяма от този БРОЙ\n"

#: src/fold.c:99
msgid ""
"  -w, --width=WIDTH\n"
"         use WIDTH columns instead of 80\n"
msgstr "  -w, --width=БРОЙ  да се ползва този БРОЙ колони, вместо 80\n"

#: src/fold.c:334 src/pr.c:840
msgid "invalid number of columns"
msgstr "неправилен брой знаци"

