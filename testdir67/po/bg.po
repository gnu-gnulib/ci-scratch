msgstr "ресурсите за „inotify“ са изчерпани"

#: src/tail.c:1573 src/tail.c:1771
#, c-format
msgid "cannot watch %s"
msgstr "„%s“ не може да се наблюдава"

#: src/tail.c:1617
#, c-format
