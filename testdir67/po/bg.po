msgstr " при повтаряне %jd\n"

#: src/csplit.c:723
#, c-format
msgid "%s: %s: match not found"
msgstr "%s: %s: не е открито съответствие"

#: src/csplit.c:784 src/csplit.c:824 src/nl.c:390 src/tac.c:282
#, c-format
