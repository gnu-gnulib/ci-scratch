#: src/pinky.c:489
msgid "  -b     omit the user's home directory and shell in long format\n"
msgstr ""
"  -b                без потребителската директория в подробния формат\n"

#: src/pinky.c:492
msgid "  -h     omit the user's project file in long format\n"
msgstr ""
"  -h                без потребителския файл-проект в подробния формат\n"

#: src/pinky.c:495
msgid "  -p     omit the user's plan file in long format\n"
msgstr "  -p                без потребителския файл-план в подробния формат\n"

#: src/pinky.c:498
msgid "  -s     do short format output, this is the default\n"
msgstr "  -s                извеждане в кратък формат (стандартно)\n"

#: src/pinky.c:501
msgid "  -f     omit the line of column headings in short format\n"
msgstr "  -f                без заглавие в съкратен формат\n"

#: src/pinky.c:504
msgid "  -w     omit the user's full name in short format\n"
msgstr "  -w                без пълните имена в съкратен формат\n"

#: src/pinky.c:507
msgid "  -i     omit the user's full name and remote host in short format\n"
msgstr ""
"  -i                без пълните имена и отдалечените хостове в съкратен "
"формат\n"

#: src/pinky.c:510
msgid ""
"  -q     omit the user's full name, remote host and idle time in short "
"format\n"
msgstr ""
"  -q                без пълните имена, отдалечените хостове и време на\n"
"                    неактивност в съкратен формат\n"

#: src/pinky.c:513
