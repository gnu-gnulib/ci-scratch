msgid ""
"  -s, --suffix=SUFFIX\n"
"         remove a trailing SUFFIX; implies -a\n"
msgstr ""
"  -s, --suffix=СУФИКС\n"
"                    премахване на такъв краен СУФИКС, включва опцията „-a“\n"

